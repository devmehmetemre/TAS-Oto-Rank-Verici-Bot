# Bu dosyayı ".env" olarak kopyala ve gerçek değerlerini doldur.
# ".env" dosyasını ASLA GitHub'a veya kimseyle paylaşma (şifrelerin gibidir).

# --- Discord Developer Portal'dan ---
DISCORD_TOKEN=
CLIENT_ID=
# GUILD_ID'yi doldurursan komutlar sadece o sunucuda anında aktif olur (test için önerilir).
# Boş bırakırsan komutlar global olur (tüm sunucular, ~1 saat gecikmeli).
GUILD_ID=

# --- Google Cloud servis hesabından ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# --- Google E-Tablo bilgileri ---
# Tablo linkindeki /d/ ile /edit arasındaki uzun kod:
# https://docs.google.com/spreadsheets/d/BURASI_SPREADSHEET_ID/edit
SPREADSHEET_ID=
# Tablonun alt sekme ismi (genelde "Sayfa1" ya da "Sheet1")
SHEET_NAME=Sheet1

# --- (Opsiyonel) Ekstra yetki kontrolü ---
# Komutu kullanabilecek Discord rol ID'leri, virgülle ayrılmış. Boş bırakabilirsin.
ALLOWED_ROLE_IDS=
